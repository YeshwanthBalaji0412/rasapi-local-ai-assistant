# ─── RasaPi Environment Configuration ────────────────────────────────────────
# Copy this file to .env and fill in values before starting the server.
# Never commit .env to version control.

# ─── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ─── Local LLM (Phase 2 — Ollama) ────────────────────────────────────────────
# Off by default. The deterministic intent router handles all known commands
# without an LLM. Set ENABLE_LOCAL_LLM=true ONLY if you intentionally want
# Ollama to handle conversational fallback queries (queries that did not
# match any safe intent).
ENABLE_LOCAL_LLM=false
LOCAL_LLM_PROVIDER=ollama

# URL of the locally-running Ollama instance (must be on the same device).
OLLAMA_BASE_URL=http://localhost:11434

# Model to use for inference (must be pulled via `ollama pull <model>`).
# llama3.2:1b is a good Pi 5 default; phi-3-mini and mistral:7b also work.
LOCAL_LLM_MODEL=llama3.2:1b

# Hard upper bound on a single LLM call. Above this, the user gets a safe
# fallback message and the request is logged as an error.
LOCAL_LLM_TIMEOUT_SECONDS=20

# ─── Security ─────────────────────────────────────────────────────────────────
# Secret used to sign internal API tokens (generate with: openssl rand -hex 32)
API_SECRET_KEY=change-me-before-use

# ─── Daily Briefing (Phase 4) ────────────────────────────────────────────────
# Whether the briefing endpoints and intents are active.
ENABLE_BRIEFING=true
# Whether to ask Ollama to generate a 2-3 sentence digest at the top of the
# daily briefing. Off by default. Both ENABLE_LOCAL_LLM and this flag must
# be true for any LLM call to happen on the briefing path.
ENABLE_LLM_BRIEFING_SUMMARY=false
BRIEFING_MAX_ITEMS_PER_CATEGORY=5
BRIEFING_DEFAULT_LOCATION="Boston, MA"
BRIEFING_WEATHER_LAT=42.3601
BRIEFING_WEATHER_LON=-71.0589
# Hard upper bound on a single source HTTP fetch.
BRIEFING_FETCH_TIMEOUT_SECONDS=10
# /ask "daily briefing" auto-refreshes only if the last successful run is
# older than this. Direct POST /briefing/refresh always fetches.
BRIEFING_CACHE_MINUTES=60

# ─── Voice I/O (Phase 7) ─────────────────────────────────────────────────────
# Voice is OFF by default. Enable explicitly after installing audio tooling
# on the device. See deployment/raspberry-pi/audio-setup.md for the Pi
# install steps. Default engines are pure-Python mocks so the backend
# starts cleanly with no audio dependencies.
ENABLE_VOICE=false
# mock | arecord | sounddevice
VOICE_RECORDER_ENGINE=mock
# mock | whisper
VOICE_STT_ENGINE=mock
# mock | piper | espeak
VOICE_TTS_ENGINE=mock
VOICE_RECORD_SECONDS=5
# Temporary audio is written here while a session is in progress and
# deleted afterward unless VOICE_SAVE_AUDIO=true. Stays under the
# gitignored backend/data/ tree.
VOICE_AUDIO_TEMP_DIR=backend/data/audio_tmp
VOICE_SAVE_AUDIO=false
# When true, voice transcripts are logged via the same `request` audit
# event /ask uses. Set to false to log only voice metadata.
VOICE_LOG_TRANSCRIPTS=true
VOICE_MAX_TRANSCRIPT_CHARS=1000
# Phase 7 has no wake word and no always-listening mode. Push-to-talk
# is the only supported flow.
VOICE_REQUIRE_PUSH_TO_TALK=true
# ALSA device hints, e.g. plughw:1,0 on the Pi. Leave blank for default.
VOICE_DEVICE_INPUT=
VOICE_DEVICE_OUTPUT=

# ─── Local Storage (Phase 3 — SQLite) ────────────────────────────────────────
# Path to the SQLite file used for memory, notes, and tasks.
# Relative to the project root; created automatically on first start.
DATABASE_PATH=backend/data/rasapi.db

# ─── Audit Logging ────────────────────────────────────────────────────────────
# Directory where audit JSONL files are written (relative to project root)
AUDIT_LOG_DIR=logs
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ─── Assistant Identity ───────────────────────────────────────────────────────
ASSISTANT_NAME=RasaPi
