# ─── RasaPi Environment Configuration ────────────────────────────────────────
# Copy this file to .env and fill in values before starting the server.
# Never commit .env to version control.

# ─── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ─── LLM (Ollama) ─────────────────────────────────────────────────────────────
# URL of the locally-running Ollama instance
OLLAMA_BASE_URL=http://localhost:11434
# Model to use for inference (must be pulled via `ollama pull`)
OLLAMA_MODEL=llama3.2:3b

# ─── Security ─────────────────────────────────────────────────────────────────
# Secret used to sign internal API tokens (generate with: openssl rand -hex 32)
API_SECRET_KEY=change-me-before-use

# ─── Audit Logging ────────────────────────────────────────────────────────────
# Directory where audit JSONL files are written (relative to project root)
AUDIT_LOG_DIR=logs
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ─── Assistant Identity ───────────────────────────────────────────────────────
ASSISTANT_NAME=RasaPi
