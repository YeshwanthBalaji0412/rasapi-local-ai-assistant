# ─── RasaPi — Raspberry Pi production-leaning .env ──────────────────────────
# Copy this file to ./.env at the repo root and chmod 600.
# Never commit a populated .env to git.

# ─── Server ──────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
DEBUG=false
LOG_LEVEL=INFO
ASSISTANT_NAME=RasaPi

# ─── Local LLM (Phase 2) ─────────────────────────────────────────────────────
# Off by default on the Pi. Verify dashboard + briefing work first, then
# decide whether your Pi can run an Ollama model.
ENABLE_LOCAL_LLM=false
LOCAL_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.2:1b
LOCAL_LLM_TIMEOUT_SECONDS=20

# ─── Local Storage (Phase 3) ─────────────────────────────────────────────────
DATABASE_PATH=backend/data/rasapi.db

# ─── Daily Briefing (Phase 4) ────────────────────────────────────────────────
ENABLE_BRIEFING=true
ENABLE_LLM_BRIEFING_SUMMARY=false
BRIEFING_MAX_ITEMS_PER_CATEGORY=5
BRIEFING_DEFAULT_LOCATION="Boston, MA"
BRIEFING_WEATHER_LAT=42.3601
BRIEFING_WEATHER_LON=-71.0589
BRIEFING_FETCH_TIMEOUT_SECONDS=10
BRIEFING_CACHE_MINUTES=60

# ─── Dashboard (Phase 5) ─────────────────────────────────────────────────────
# Mask absolute filesystem paths in the dashboard UI.
DASHBOARD_MASK_DB_PATH=true

# ─── Audit Logging ───────────────────────────────────────────────────────────
AUDIT_LOG_DIR=logs

# ─── Security ────────────────────────────────────────────────────────────────
# Generate a fresh value with:
#   bash deployment/raspberry-pi/generate-secret.sh
# Do NOT keep the placeholder in real deployments.
API_SECRET_KEY=replace-with-output-of-generate-secret-sh

# ─── Authentication (Phase 8) ────────────────────────────────────────────────
# Strongly recommend turning this on before exposing RasaPi over the LAN
# or via Tailscale. See deployment/raspberry-pi/remote-access.md.
ENABLE_AUTH=false
AUTH_PROTECT_DASHBOARD=true
AUTH_PROTECT_ASK=true
AUTH_PROTECT_VOICE=true
AUTH_PROTECT_MUTATIONS=true
SESSION_COOKIE_NAME=rasapi_session
SESSION_TTL_MINUTES=720
COOKIE_SECURE=false
CSRF_COOKIE_NAME=rasapi_csrf
AUTH_PROTECT_INTEGRATIONS=true

# ─── Integrations (Phase 9) ──────────────────────────────────────────────────
# All integrations OFF by default. Enable explicitly. Secrets stay in .env.
ENABLE_SLACK=false
SLACK_WEBHOOK_URL=
SLACK_DEFAULT_CHANNEL=
SLACK_SEND_BRIEFING_ENABLED=false
SLACK_SEND_AUDIT_ALERTS_ENABLED=false

ENABLE_HOME_ASSISTANT=false
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_ALLOWED_ENTITIES=
HOME_ASSISTANT_ALLOWED_DOMAINS=light,switch,sensor
HOME_ASSISTANT_REQUIRE_CONFIRMATION=true

# ─── Recommended Raspberry Pi voice config (Phase 10 polish) ────────────────
# Once you've installed whisper.cpp and Piper (see audio-setup.md), set the
# real model paths below and ENABLE_VOICE=true. No symlinks, no wrappers.
#
# ENABLE_VOICE=true
# VOICE_RECORDER_ENGINE=arecord
# VOICE_STT_ENGINE=whisper
# VOICE_TTS_ENGINE=piper
# VOICE_DEVICE_INPUT=pulse
# VOICE_DEVICE_OUTPUT=
# VOICE_WHISPER_MODEL_PATH=/home/<PI_USER>/whisper.cpp/models/ggml-tiny.en.bin
# VOICE_PIPER_MODEL_PATH=/home/<PI_USER>/piper-voices/en_US-amy-low.onnx
# VOICE_PIPER_CONFIG_PATH=
# VOICE_TTS_PLAYBACK_COMMAND=auto
# VOICE_SAVE_AUDIO=false

# Voice model paths (declared here so .env loads cleanly even when unset)
VOICE_WHISPER_MODEL_PATH=
VOICE_PIPER_MODEL_PATH=
VOICE_PIPER_CONFIG_PATH=
VOICE_TTS_PLAYBACK_COMMAND=auto
