# Companion oneshot service for rasapi-briefing.timer.
# Adjust User= and the path to match your install.

[Unit]
Description=RasaPi daily briefing refresh (one-shot)
After=network-online.target rasapi.service
Wants=network-online.target

[Service]
Type=oneshot
User=yesh
WorkingDirectory=/home/yesh/rasapi-local-ai-assistant
ExecStart=/usr/bin/bash deployment/raspberry-pi/run-daily-briefing.sh
# Optional: API key for /briefing/refresh if auth is added later.
# EnvironmentFile=-/etc/rasapi/key.env
StandardOutput=journal
StandardError=journal
